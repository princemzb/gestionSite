// Préproduction gestionSite (DEP-01). Secrets à poser une fois : voir docs/exploitation/DEPLOIEMENT.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestionsite-preprod",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "GestionSite",
      // Politique imposée par Cloudflare pour ce compte : type d'instance et démarrage dans src/index.ts.
      "scheduling_policy": "durable_object",
      "images": {
        "application": { "dockerfile": "../../server/Dockerfile", "build_context": "../.." }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GESTIONSITE", "class_name": "GestionSite" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GestionSite"] }],
  // Déclencheur de secours du planificateur (US-10, S10-02) : un passage par jour, 7 h 05 UTC (8 h 05 ou 9 h 05 à
  // Paris, après les rappels de réexamen de 8 h). Les rappels partent normalement par l'alarme du Durable Object.
  "triggers": { "crons": ["5 7 * * *"] },
  "vars": {
    // Adresse publique : déduite de la requête par le Worker. Point d'accès R2 (juridiction UE) : secret R2_URL.
    "R2_COMPARTIMENT": "gestionsite-preprod",
    "R2_CLES_COMPARTIMENT": "gestionsite-preprod-cles"
  }
}
