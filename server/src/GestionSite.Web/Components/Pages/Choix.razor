@page "/s/{Code}"
@layout PublicLayout
@inject DepotPublicClient Depots

<PageTitle>Signaler un problème</PageTitle>

@if (Indisponible)
{
    <h1>Service momentanément indisponible</h1>
    <p class="note">Réessayez dans un instant.</p>
}
else if (Site is null)
{
    <h1>Ce lien n'est pas valable</h1>
    <p class="note">Vérifiez l'adresse affichée sur place, ou scannez à nouveau le QR code.</p>
}
else
{
    <div class="public-entete">
        <span class="note">@Site.Organisation · @Site.Site</span>
        <h1>Bonjour. Que voulez-vous signaler ?</h1>
    </div>
    <a class="tuile tuile-danger" href="@($"/s/{Code}/signaler?choix=danger")">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20z"></path><path d="M12 10v4"></path><path d="M12 17h.01"></path></svg>
        <span><strong>Il y a un danger</strong><span>Fuite, électricité, chute possible… L'équipe est alertée en priorité.</span></span>
    </a>
    <a class="tuile" href="@($"/s/{Code}/signaler?choix=incident")">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"></path></svg>
        <span><strong>Quelque chose est abîmé</strong><span>Panne, casse, usure : un incident.</span></span>
    </a>
    <a class="tuile" href="@($"/s/{Code}/signaler?choix=demande")">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path><rect x="3" y="3" width="18" height="18" rx="5"></rect></svg>
        <span><strong>J'ai besoin de quelque chose</strong><span>Matériel, aménagement, intervention : une demande.</span></span>
    </a>
    <p class="note centre">Ensuite : où, une photo si vous voulez, et comment vous recontacter. Sans compte, aucun suivi en ligne.</p>
}

@code {
    [Parameter] public string Code { get; set; } = string.Empty;

    private SitePublicApi? Site { get; set; }

    private bool Indisponible { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Site = await Depots.SiteAsync(Code, CancellationToken.None);
        }
        catch (DepotIndisponibleException)
        {
            Indisponible = true;
        }
    }
}
