    {
        "priorite" => "Choisissez une priorité.",
        "zoneId" => "Choisissez une zone du site.",
        "composantId" => "Le composant doit être un composant actif de la zone choisie.",
        "motif" => "Choisissez un motif.",
        "commentaire" => "Commentaire obligatoire pour le motif « Autre » (500 caractères au plus).",
        "titre" => "Donnez un intitulé à l'intervention (120 caractères au plus).",
        "intervenantCompteId" => "Choisissez un technicien du site, ou un prestataire et son référent.",
        "referentCompteId" => "Un prestataire est suivi par un référent interne du site.",
        "prestataire" => "Nom du prestataire : une ligne visible de 120 caractères au plus.",
        "reexamenLe" => "Date de réexamen entre aujourd'hui et un an.",
        "actions" => "Décrivez les actions réalisées (2000 caractères au plus).",
        "etatFinal" => "Choisissez l'état final.",
        "photos" => "Photo obligatoire pour ce corps d'état (3 au plus, 10 Mo chacune, JPEG, PNG ou HEIC).",
        "principalId" => "Choisissez un autre dossier ouvert du site.",
        _ => "Saisie refusée : vérifiez le formulaire.",
