    private static string MessageIssue(string code) => code switch
    {
        "modifie_entre_temps" => "Quelqu'un d'autre vient de modifier ce dossier : la fiche est rechargée, recommencez.",
        "statut_incompatible" => "Cette action n'est plus possible dans l'état actuel du dossier.",
        "non_qualifie" => "Qualifiez le dossier (priorité et zone) avant de l'affecter.",
        "doublons_rattaches" => "Ce dossier porte des doublons : traitez-le comme dossier principal.",
        "interdit" => "Vous n'avez pas le droit de faire cette action.",
        _ => "Service momentanément indisponible : réessayez dans un instant.",
    };

    private string Url(string onglet, params (string Cle, string Valeur)[] extra) =>
        $"/organisations/{OrganisationId}/dossiers/{DossierId}?site={SiteCourant?.Id}&onglet={onglet}{string.Concat(extra.Select(e => $"&{e.Cle}={Uri.EscapeDataString(e.Valeur)}"))}";

    private static int Rang(string etape) => Array.FindIndex(LibellesDossiers.Etapes, e => e.Code == etape);

    private string NomZone(Guid zoneId) =>
        Structure.SelectMany(b => b.Zones.Select(z => (b, z))).FirstOrDefault(x => x.z.Id == zoneId) is { b: not null } trouve
            ? $"{trouve.b.Nom} · {trouve.z.Nom}"
            : "Zone";

    // Détail lisible d'un événement du journal (priorité, motif, intervention…).
    private static string Detail(EvenementDossierApi e)
    {
        if (e.Detail is not { ValueKind: JsonValueKind.Object } detail)
        {
            return string.Empty;
        }

        string? Texte(string nom) => detail.TryGetProperty(nom, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
        var morceaux = new[]
        {
            Texte("priorite") is { } p ? $"priorité {LibellesDossiers.Priorite(p).ToLowerInvariant()}" : null,
            Texte("zone"),
            Texte("composant"),
            Texte("titre"),
            Texte("prestataire") is { } pr ? $"prestataire {pr}" : null,
            Texte("motif") is { } m ? LibellesDossiers.Libelle([.. LibellesDossiers.MotifsClassement, .. LibellesDossiers.MotifsAttente], m) : null,
            Texte("etatFinal") is { } ef ? LibellesDossiers.Libelle(LibellesDossiers.EtatsFinaux, ef) : null,
            Texte("commentaire"),
        }.Where(t => !string.IsNullOrWhiteSpace(t));
        var texte = string.Join(" · ", morceaux);
        return texte.Length == 0 ? string.Empty : $" : {texte}";
    }

