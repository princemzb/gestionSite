@page "/reinitialisation"
@inject SessionApi Session
@inject NavigationManager Navigation

<PageTitle>Nouveau mot de passe · gestionSite</PageTitle>

@* Maquette 5A (US-31) : page ouverte par le lien de réinitialisation, mêmes règles que l'activation. *@
<h2>Nouveau mot de passe</h2>
@if (LienInvalide)
{
    <p role="alert" class="alerte avertissement"><strong>Lien expiré ou déjà utilisé.</strong> Demandez un nouveau lien à l'administrateur de votre organisation.</p>
    <p class="note"><a href="/connexion">← Retour à la connexion</a></p>
}
else
{
    <EditForm Model="Saisie" FormName="reinitialisation" OnSubmit="ReinitialiserAsync" class="formulaire pleine-largeur">
        <input type="hidden" name="Saisie.Jeton" value="@(Saisie.Jeton ?? Jeton)" />
        <label class="champ">Nouveau mot de passe
            <InputText type="password" @bind-Value="Saisie.MotDePasse" autocomplete="new-password" aria-describedby="regle" required />
            <span id="regle" class="aide">Au moins 12 caractères. Une phrase facile à retenir convient.</span>
        </label>
        <label class="champ">Confirmer le mot de passe
            <InputText type="password" @bind-Value="Saisie.Confirmation" autocomplete="new-password" required />
        </label>
        <p class="alerte information">Vos autres appareils seront déconnectés (dans les 15 minutes au plus).</p>
        @if (Message is not null)
        {
            <p role="alert" class="alerte danger">@Message</p>
        }
        <button type="submit" class="bouton-principal">Enregistrer et me connecter</button>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "jeton")]
    private string? Jeton { get; set; }

    // Le formulaire posté remplit Formulaire (préfixe « Saisie ») ; sans envoi, une saisie vide.
    [SupplyParameterFromForm(Name = "Saisie", FormName = "reinitialisation")]
    private SaisieReinitialisation? Formulaire { get; set; }

    private SaisieReinitialisation Saisie => Formulaire ??= new();

    private string? Message { get; set; }

    private bool LienInvalide { get; set; }

    private async Task ReinitialiserAsync()
    {
        var motDePasse = Saisie.MotDePasse ?? string.Empty;
        if (motDePasse.Length < 12)
        {
            Message = "Le mot de passe doit contenir au moins 12 caractères.";
            return;
        }

        if (motDePasse != Saisie.Confirmation)
        {
            Message = "Les deux mots de passe ne sont pas identiques.";
            return;
        }

        switch (await Session.ReinitialiserAsync(Saisie.Jeton ?? string.Empty, motDePasse, CancellationToken.None))
        {
            case IssueConnexion.Reussie:
                Navigation.NavigateTo("/");
                break;
            case IssueConnexion.LienInvalide:
                LienInvalide = true;
                break;
            case IssueConnexion.ActiveSansConnexion:
                Navigation.NavigateTo("/connexion?reinitialise=1");
                break;
            case IssueConnexion.MotDePasseInvalide:
                Message = "Le mot de passe doit contenir au moins 12 caractères.";
                break;
            default:
                Message = "Service momentanément indisponible. Réessayez dans un instant.";
                break;
        }
    }

    private sealed class SaisieReinitialisation
    {
        public string? Jeton { get; set; }

        public string? MotDePasse { get; set; }

        public string? Confirmation { get; set; }
    }
}
