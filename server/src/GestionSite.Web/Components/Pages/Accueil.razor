@page "/"
@attribute [Authorize]
@inject SessionApi Session
@inject NavigationManager Navigation

<PageTitle>gestionSite</PageTitle>

@if (Message is not null)
{
    <p role="alert" class="alerte danger">@Message</p>
}
@switch (Issue)
{
    case "acceptee" when Rejointe is null:
        <p role="status" class="alerte succes"><strong>Invitation acceptée.</strong></p>
        <div class="actions gauche"><a class="bouton-principal lien-bouton" href="/?continuer=1">Continuer</a></div>
        break;
    case "acceptee":
        <p role="status" class="alerte succes"><strong>Vous avez rejoint @Rejointe.Nom.</strong></p>
        <div class="actions gauche">
            <a class="bouton-principal lien-bouton" href="@($"/?organisation={Rejointe!.Id}")">Ouvrir @Rejointe.Nom</a>
            @if (Autre is not null)
            {
                <a class="bouton-secondaire lien-bouton" href="@($"/?organisation={Autre.Id}")">Rester sur @Autre.Nom</a>
            }
        </div>
        break;
    case "refusee":
        <p role="status" class="alerte succes">Invitation refusée. Vous n'avez aucun accès à cette organisation.</p>
        break;
    case "modifiee":
        <p role="alert" class="alerte avertissement"><strong>L'invitation a été modifiée entre-temps.</strong> Relisez les rôles proposés aujourd'hui, puis répondez.</p>
        break;
    case "introuvable":
        <p role="alert" class="alerte danger"><strong>Cette invitation n'est plus valable.</strong> L'organisation l'a annulée. Rien n'a changé pour votre compte.</p>
        break;
    case "indisponible":
        <p role="alert" class="alerte danger">Service momentanément indisponible. Réessayez dans un instant.</p>
        break;
}

@if (Moi is { Organisations.Count: 0 } && Moi.Invitations is { Count: > 0 } invitations)
{
    <h2>Invitations</h2>
    <p class="note">Vous n'avez encore accès à aucune organisation. Acceptez une invitation pour commencer.</p>
    @foreach (var invitation in invitations)
    {
        <CarteInvitation Invitation="invitation" />
    }
}
else if (Moi is { Organisations.Count: 0 })
{
    <h2>Votre compte est actif</h2>
    <p class="note">Vous n'avez accès à aucune organisation pour l'instant. Demandez une invitation à son administrateur.</p>
}
else if (Moi is not null && Issue is not null && Issue != "acceptee")
{
    <div class="actions gauche"><a class="bouton-principal lien-bouton" href="/?continuer=1">Continuer</a></div>
}
<form method="post" action="/deconnexion">
    <AntiforgeryToken />
    <button type="submit" class="bouton-secondaire">Se déconnecter</button>
</form>

@code {
    /// <summary>Organisation choisie (sélecteur du menu, ou « Ouvrir » après une invitation acceptée).</summary>
    [SupplyParameterFromQuery(Name = "organisation")]
    private Guid? Choisie { get; set; }

    /// <summary>Issue d'une réponse à une invitation : acceptee, refusee, modifiee, introuvable, indisponible.</summary>
    [SupplyParameterFromQuery(Name = "invitation")]
    private string? Issue { get; set; }

    private MoiApi? Moi { get; set; }

    private OrganisationApi? Rejointe { get; set; }

    private OrganisationApi? Autre { get; set; }

    private string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Moi = await Session.MoiAsync(CancellationToken.None);
        }
        catch (SessionExpireeException)
        {
            Navigation.NavigateTo("/connexion");
            return;
        }
        catch (RefusApiException refus)
        {
            Message = refus.Message;
            return;
        }

        if (Issue == "acceptee")
        {
            Rejointe = Moi.Organisations.FirstOrDefault(o => o.Id == Choisie);
            Autre = Moi.Organisations.FirstOrDefault(o => o.Id != Choisie);
            return;
        }

        if (Issue is not null)
        {
            return; // message de l'issue, puis « Continuer »
        }

        // Les comptes internes d'un site arrivent sur les dossiers ; l'administrateur sans rôle de site, sur les membres.
        // Organisation choisie qui n'est plus la sienne (révocation, favori ancien) : comme sans choix.
        var organisations = Moi.Organisations.Where(o => o.Id == Choisie).ToList() is { Count: > 0 } choisies ? choisies : [.. Moi.Organisations];
        var interne = organisations.FirstOrDefault(o => o.Roles.Any(r => r.Role != "Administrateur"));
        var administree = organisations.FirstOrDefault(o => o.Roles.Any(r => r.Role == "Administrateur"));
        if (interne is not null)
        {
            Navigation.NavigateTo($"/organisations/{interne.Id}/dossiers");
        }
        else if (administree is not null)
        {
            Navigation.NavigateTo($"/organisations/{administree.Id}/membres");
        }
    }
}
