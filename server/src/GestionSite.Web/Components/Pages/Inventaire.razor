    }

    private sealed class SaisieComposant
    {
        public Guid? Id { get; set; }

        public uint? Version { get; set; }

        public string? Nom { get; set; }

        public string? CorpsEtat { get; set; }

        public Guid? ZoneId { get; set; }

        public string? Emplacement { get; set; }

        public string? Marque { get; set; }

        public string? Modele { get; set; }

        public string? NumeroSerie { get; set; }

        public int? Annee { get; set; }

        public int? Mois { get; set; }

        public string? Remarques { get; set; }

        public string? Verification { get; set; }

        public string Mode { get; set; } = "individuel";

        public int? Quantite { get; set; }

        public string Unite { get; set; } = "Unite";

        public int? Bon { get; set; }

        public int? Satisfaisant { get; set; }

        public int? Degrade { get; set; }

        public int? Mauvais { get; set; }

        public int? Critique { get; set; }

        internal static SaisieComposant Depuis(ComposantApi c) => new()
        {
            Id = c.Id, Version = c.Version, Nom = c.Nom, CorpsEtat = c.CorpsEtat, ZoneId = c.ZoneId, Emplacement = c.Emplacement,
            Marque = c.Marque, Modele = c.Modele, NumeroSerie = c.NumeroSerie, Annee = c.AnneeMiseEnService, Mois = c.MoisMiseEnService,
            Remarques = c.Remarques, Verification = c.SoumisAVerification ? "oui" : "non", Mode = c.Lot is null ? "individuel" : "lot",
            Quantite = c.Lot?.Quantite, Unite = c.Lot?.Unite ?? "Unite", Bon = c.Lot?.Repartition?.Bon, Satisfaisant = c.Lot?.Repartition?.Satisfaisant,
            Degrade = c.Lot?.Repartition?.Degrade, Mauvais = c.Lot?.Repartition?.Mauvais, Critique = c.Lot?.Repartition?.Critique,
        };

        // Lot : répartition envoyée seulement si au moins un état est saisi ; sinon le lot est « non évalué ».
        internal object Corps()
        {
            var repartition = (Bon ?? Satisfaisant ?? Degrade ?? Mauvais ?? Critique) is null
                ? null
                : new { bon = Bon ?? 0, satisfaisant = Satisfaisant ?? 0, degrade = Degrade ?? 0, mauvais = Mauvais ?? 0, critique = Critique ?? 0 };
            return new
            {
                nom = Nom, corpsEtat = CorpsEtat, zoneId = ZoneId, emplacement = Emplacement, marque = Marque, modele = Modele,
                numeroSerie = NumeroSerie, anneeMiseEnService = Annee, moisMiseEnService = Mois, remarques = Remarques,
                soumisAVerification = Verification switch { "oui" => true, "non" => (bool?)false, _ => null },
                lot = Mode == "lot" ? new { unite = Unite, quantite = Quantite, repartition } : null,
                version = Version,
            };
        }
    }
