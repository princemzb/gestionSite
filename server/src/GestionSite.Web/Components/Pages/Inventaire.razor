@page "/organisations/{OrganisationId:guid}/inventaire"
@layout AdminLayout
@attribute [Authorize]
@using System.Text.Json
@using GestionSite.Web.Inventaire
@inject SessionApi Session
@inject NavigationManager Navigation

<NavigationAdmin OrganisationId="@OrganisationId" Organisation="@Organisation?.Nom" Roles="@RolesAppelant" Courant="inventaire" />
<main class="admin-contenu">
<PageTitle>Inventaire · gestionSite</PageTitle>

@if (Message is not null && Organisation is null)
{
    <div class="entete"><div><h1>Inventaire</h1></div></div>
    <p role="alert" class="alerte danger">@Message</p>
}
else if (Organisation is null || Sites.Count == 0)
{
    <div class="entete"><div><h1>Inventaire</h1><p>Aucun site ne vous est attribué dans cette organisation.</p></div></div>
}
else
{
    <div class="entete">
        <div>
            <h1>Inventaire · @SiteCourant!.Nom</h1>
            <p>@Resume</p>
        </div>
        <div class="actions">
            @if (Sites.Count > 1)
            {
                <nav class="onglets" aria-label="Site">
                    @foreach (var site in Sites)
                    {
                        <a href="@($"/organisations/{OrganisationId}/inventaire?site={site.Id}")" aria-current="@(site.Id == SiteCourant.Id ? "page" : null)">@site.Nom</a>
                    }
                </nav>
            }
            @if (PeutModifier)
            {
                <a class="bouton-secondaire bouton-lien" href="@Url(("action", "batiment"))">Ajouter un bâtiment</a>
                @if (Structure.Count > 0)
                {
                    <a class="bouton-principal bouton-lien" href="@Url(("action", "composant"), ("composant", null))">Ajouter un composant</a>
                }
            }
        </div>
    </div>

    @if (Message is not null)
    {
        <p role="alert" class="alerte danger">@Message</p>
    }

    <form method="get" class="carte filtres" aria-label="Filtres">
        <input type="hidden" name="site" value="@SiteCourant.Id" />
        @if (ZoneDemandee is { } zoneFiltre)
        {
            <input type="hidden" name="zone" value="@zoneFiltre" />
        }
        <label class="champ">Bâtiment
            <select name="batiment">
                <option value="">Tous</option>
                @foreach (var b in Structure)
                {
                    <option value="@b.Id" selected="@(b.Id == BatimentDemande)">@b.Nom</option>
                }
            </select>
        </label>
        <label class="champ">Corps d'état
            <select name="corpsEtat">
                <option value="">Tous</option>
                @foreach (var (valeur, libelle) in Libelles.CorpsEtats)
                {
                    <option value="@valeur" selected="@(valeur == CorpsEtatDemande)">@libelle</option>
                }
            </select>
        </label>
        <label class="case"><input type="checkbox" name="verification" value="true" checked="@(VerificationDemandee == true)" /> Soumis à vérification</label>
        <label class="champ recherche">Rechercher
            <input type="search" name="recherche" value="@RechercheDemandee" maxlength="200" placeholder="Nom, marque, modèle, n° de série…" />
        </label>
        <label class="case"><input type="checkbox" name="retires" value="true" checked="@(RetiresDemandes == true)" /> Retirés</label>
        <button type="submit" class="bouton-secondaire">Filtrer</button>
        @if (Filtre)
        {
            <a class="bouton-lien lien-discret" href="@($"/organisations/{OrganisationId}/inventaire?site={SiteCourant.Id}")">Effacer</a>
        }
    </form>

    @if ((Action == "batiment" || (Action is "niveau" or "zone" && BatimentDuFormulaire is not null)) && PeutModifier)
    {
        <section class="carte formulaire-inventaire" aria-label="Structure du site">
            <EditForm Model="StructureSaisie" FormName="structure" OnSubmit="EnregistrerStructureAsync" class="formulaire-inventaire">
                <input type="hidden" name="StructureSaisie.Type" value="@Action" />
                @if (Action == "batiment")
                {
                    <h2>Nouveau bâtiment</h2>
                    <p class="note">Les extérieurs se décrivent comme un bâtiment « Extérieurs » (parvis, parking, jardin…). Une zone « Parties communes » est créée avec chaque bâtiment.</p>
                }
                else if (BatimentDuFormulaire is { } cible)
                {
                    <h2>@(Action == "niveau" ? "Nouveau niveau" : "Nouvelle zone") · @cible.Nom</h2>
                    <input type="hidden" name="StructureSaisie.BatimentId" value="@cible.Id" />
                }
                <label class="champ">Nom
                    <InputText @bind-Value="StructureSaisie.Nom" required maxlength="120" placeholder="@(Action switch { "batiment" => "Église, Salles annexes, Extérieurs…", "niveau" => "Sous-sol, Rez-de-chaussée, 1er étage…", _ => "Sacristie, Grande salle, Sanitaires…" })" />
                </label>
                @if (Action == "niveau")
                {
                    <label class="champ">Ordre <span class="aide">(sous-sol −1, rez-de-chaussée 0, 1er étage 1…)</span>
                        <InputNumber @bind-Value="StructureSaisie.Ordre" required min="-10" max="100" />
                    </label>
                }
                else if (Action == "zone")
                {
                    <label class="champ">Niveau <span class="aide">(facultatif)</span>
                        <InputSelect @bind-Value="StructureSaisie.NiveauId">
                            <option value="">Sans niveau</option>
                            @foreach (var n in BatimentDuFormulaire?.Niveaux ?? [])
                            {
                                <option value="@n.Id">@n.Nom</option>
                            }
                        </InputSelect>
                    </label>
                }
                <div class="actions">
                    <a class="bouton-secondaire bouton-lien" href="@Url(("action", null))">Annuler</a>
                    <button type="submit" class="bouton-principal">Enregistrer</button>
                </div>
            </EditForm>
        </section>
    }

    @if ((Action == "composant" || (Action == "modifier" && Fiche is { Composant.RetireLe: null })) && PeutModifier && Structure.Count > 0)
    {
        <section class="carte formulaire-inventaire" aria-label="Fiche du composant">
            <EditForm Model="ComposantSaisi" FormName="composant" OnSubmit="EnregistrerComposantAsync" class="formulaire-inventaire">
                <input type="hidden" name="ComposantSaisi.Id" value="@ComposantSaisi.Id" />
                <input type="hidden" name="ComposantSaisi.Version" value="@ComposantSaisi.Version" />
                <h2>@(ComposantSaisi.Id is null ? "Nouveau composant" : $"Modifier · {Fiche?.Composant.Nom}")</h2>
                <div class="grille-champs">
                    <label class="champ">Nom
                        <InputText @bind-Value="ComposantSaisi.Nom" required maxlength="120" placeholder="Extincteur CO2 2 kg, Chaises, Tableau divisionnaire…" />
                    </label>
                    <label class="champ">Corps d'état
                        <InputSelect @bind-Value="ComposantSaisi.CorpsEtat" required>
                            <option value="">Choisir…</option>
                            @foreach (var (valeur, libelle) in Libelles.CorpsEtats)
                            {
                                <option value="@valeur">@libelle</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="champ">Zone
                        <InputSelect @bind-Value="ComposantSaisi.ZoneId" required>
                            <option value="">Choisir…</option>
                            @foreach (var b in Structure)
                            {
                                <optgroup label="@b.Nom">
                                    @foreach (var z in ZonesRangees(b))
                                    {
                                        <option value="@z.Id">@NomZone(b, z)</option>
                                    }
                                </optgroup>
                            }
                        </InputSelect>
                    </label>
                    <label class="champ">Emplacement précis
                        <InputText @bind-Value="ComposantSaisi.Emplacement" maxlength="200" placeholder="Près de la sortie côté nef…" />
                    </label>
                    <label class="champ">Marque
                        <InputText @bind-Value="ComposantSaisi.Marque" maxlength="120" />
                    </label>
                    <label class="champ">Modèle
                        <InputText @bind-Value="ComposantSaisi.Modele" maxlength="120" />
                    </label>
                    <label class="champ">N° de série
                        <InputText @bind-Value="ComposantSaisi.NumeroSerie" maxlength="120" placeholder="Facultatif pour un lot" />
                    </label>
                    <div class="champ">
                        <span>Mise en service <span class="aide">(plaque signalétique)</span></span>
                        <div class="ligne-champs">
                            <InputNumber @bind-Value="ComposantSaisi.Annee" min="1000" max="@DateTime.UtcNow.Year" placeholder="Année" aria-label="Année de mise en service" />
                            <InputSelect @bind-Value="ComposantSaisi.Mois" aria-label="Mois de mise en service">
                                <option value="">Mois (facultatif)</option>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    <option value="@m">@Libelles.Mois[m - 1]</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>
                <label class="champ">Soumis à vérification périodique
                    <InputSelect @bind-Value="ComposantSaisi.Verification">
                        @if (ComposantSaisi.Id is null)
                        {
                            <option value="">Selon le corps d'état (proposé)</option>
                        }
                        <option value="oui">Oui</option>
                        <option value="non">Non</option>
                    </InputSelect>
                    <span class="aide">Proposé pour l'électricité, l'éclairage de sécurité, la sécurité incendie, le chauffage, le gaz, les ascenseurs, le paratonnerre et les cloches.</span>
                </label>
                <fieldset class="lot">
                    <legend>Quantité</legend>
                    <div class="ligne-champs">
                        <label class="champ">Suivi
                            <InputSelect @bind-Value="ComposantSaisi.Mode">
                                <option value="individuel">Composant individuel</option>
                                <option value="lot">Lot (plusieurs identiques)</option>
                            </InputSelect>
                        </label>
                        <label class="champ">Quantité totale
                            <InputNumber @bind-Value="ComposantSaisi.Quantite" min="1" max="100000" />
                        </label>
                        <label class="champ">Unité
                            <InputSelect @bind-Value="ComposantSaisi.Unite">
                                @foreach (var (valeur, libelle, _) in Libelles.Unites)
                                {
                                    <option value="@valeur">@libelle</option>
                                }
                            </InputSelect>
                        </label>
                    </div>
                    <span class="note">Répartition par état <span class="aide">(lot seulement, facultative ; la somme doit égaler la quantité)</span></span>
                    <div class="grille-etats">
                        <label class="champ etat-bon">Bon<InputNumber @bind-Value="ComposantSaisi.Bon" min="0" /></label>
                        <label class="champ etat-satisfaisant">Satisfaisant<InputNumber @bind-Value="ComposantSaisi.Satisfaisant" min="0" /></label>
                        <label class="champ etat-degrade">Dégradé<InputNumber @bind-Value="ComposantSaisi.Degrade" min="0" /></label>
                        <label class="champ etat-mauvais">Mauvais<InputNumber @bind-Value="ComposantSaisi.Mauvais" min="0" /></label>
                        <label class="champ etat-critique">Critique<InputNumber @bind-Value="ComposantSaisi.Critique" min="0" /></label>
                    </div>
                </fieldset>
                <label class="champ">Remarques
                    <InputTextArea @bind-Value="ComposantSaisi.Remarques" rows="2" maxlength="2000" />
                </label>
                <div class="actions">
                    <a class="bouton-secondaire bouton-lien" href="@Url(("action", null))">Annuler</a>
                    <button type="submit" class="bouton-principal">Enregistrer</button>
                </div>
            </EditForm>
        </section>
    }

    <div class="inventaire">
        <section class="carte arbre" aria-label="Bâtiments et zones">
            <a href="@Url(("zone", null), ("batiment", null))" aria-current="@(ZoneDemandee is null && BatimentDemande is null ? "page" : null)" class="arbre-site">Tout le site <span>@ComptesParZone.Values.Sum()</span></a>
            @if (Structure.Count == 0)
            {
                <p class="note">Commencez par ajouter un bâtiment.</p>
            }
            @foreach (var b in Structure)
            {
                <a class="arbre-batiment" href="@Url(("batiment", b.Id.ToString()), ("zone", null))" aria-current="@(BatimentDemande == b.Id && ZoneDemandee is null ? "page" : null)">@b.Nom</a>
                @foreach (var (niveau, zone) in Arborescence(b))
                {
                    if (zone is null)
                    {
                        <span class="arbre-niveau">@niveau!.Nom</span>
                    }
                    else
                    {
                        @LienZone(zone, retrait: zone.NiveauId is null ? 1 : 2)
                    }
                }
                @if (PeutModifier)
                {
                    <span class="arbre-ajouts">
                        <a href="@Url(("action", "zone"), ("pour", b.Id.ToString()))">+ Zone</a>
                        <a href="@Url(("action", "niveau"), ("pour", b.Id.ToString()))">+ Niveau</a>
                    </span>
                }
            }
        </section>

        <section class="carte tableau-conteneur liste-composants" aria-label="Composants">
            @if (Composants.Count == 0)
            {
                <p class="vide-carte">@(Filtre ? "Aucun composant ne correspond à ces filtres." : Structure.Count == 0 ? "L'inventaire est vide." : "Aucun composant pour l'instant.")</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Composant</th><th scope="col">Corps d'état</th>
                            @if (ZoneDemandee is null)
                            {
                                <th scope="col">Zone</th>
                            }
                            <th scope="col">Quantité et état</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Composants)
                        {
                            var choisi = c.Id == Fiche?.Composant.Id;
                            <tr class="@(choisi ? "choisi" : null)">
                                <td>
                                    <a class="nom-composant" href="@Url(("composant", c.Id.ToString()), ("action", null))" aria-current="@(choisi ? "true" : null)">@c.Nom</a>
                                    @if (c.Lot is not null)
                                    {
                                        <span class="vide"> · lot</span>
                                    }
                                    @if (c.SoumisAVerification)
                                    {
                                        <span class="badge verification" title="Soumis à vérification périodique">Vérif.</span>
                                    }
                                    @if (c.RetireLe is not null)
                                    {
                                        <span class="badge retire">Retiré</span>
                                    }
                                </td>
                                <td>@Libelles.CorpsEtat(c.CorpsEtat)</td>
                                @if (ZoneDemandee is null)
                                {
                                    @* Zone sélectionnée dans l'arborescence : colonne inutile. *@
                                    <td>@(Zones.TryGetValue(c.ZoneId, out var lieu) ? lieu : "—")</td>
                                }
                                <td>@QuantiteEtEtat(c)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Tronquee)
                {
                    <p class="note encadre">Seuls les 1000 premiers composants sont affichés : affinez avec les filtres.</p>
                }
            }
        </section>

        @if (Fiche is { } fiche)
        {
            var c = fiche.Composant;
            <aside class="carte fiche-composant" aria-label="Fiche du composant">
                <span class="note">@Libelles.CorpsEtat(c.CorpsEtat)@(c.Lot is null ? "" : " · lot") · @(Zones.TryGetValue(c.ZoneId, out var lieu) ? lieu : "")</span>
                <h2>@c.Nom</h2>
                @if (c.RetireLe is { } retireLe)
                {
                    <p class="alerte avertissement">Retiré le @Date(retireLe) : @c.MotifRetrait</p>
                }
                <dl>
                    @if (c.Lot is { } lot)
                    {
                        <dt>Quantité</dt><dd>@lot.Quantite @Libelles.Unite(lot.Unite, lot.Quantite)</dd>
                        @if (lot.Repartition is { } r)
                        {
                            @foreach (var (cle, libelle, _) in Libelles.Etats)
                            {
                                var nombre = Nombre(r, cle);
                                if (nombre > 0)
                                {
                                    <dt>@libelle</dt><dd>@nombre</dd>
                                }
                            }
                        }
                    }
                    <dt>Vérification périodique</dt><dd>@(c.SoumisAVerification ? "Oui" : "Non")</dd>
                    @if (c.Emplacement is not null) { <dt>Emplacement</dt><dd>@c.Emplacement</dd> }
                    @if (c.Marque is not null || c.Modele is not null) { <dt>Marque · modèle</dt><dd>@string.Join(" · ", new[] { c.Marque, c.Modele }.Where(t => t is not null))</dd> }
                    @if (c.NumeroSerie is not null) { <dt>N° de série</dt><dd>@c.NumeroSerie</dd> }
                    <dt>Mise en service</dt><dd>@Libelles.MiseEnService(c.AnneeMiseEnService, c.MoisMiseEnService)</dd>
                </dl>
                @if (c.Remarques is not null)
                {
                    <p class="texte-libre">@c.Remarques</p>
                }
                @if (PeutModifier && c.RetireLe is null)
                {
                    <div class="actions debut">
                        <a class="bouton-secondaire bouton-lien" href="@Url(("action", "modifier"))">Modifier</a>
                        <a class="bouton-secondaire bouton-lien" href="@Url(("action", "retirer"))">Retirer</a>
                    </div>
                    @if (Action == "retirer")
                    {
                        <EditForm Model="RetraitSaisi" FormName="retrait" OnSubmit="RetirerAsync" class="formulaire-inventaire retrait">
                            <input type="hidden" name="RetraitSaisi.Version" value="@c.Version" />
                            <label class="champ">Motif du retrait
                                <InputText @bind-Value="RetraitSaisi.Motif" required maxlength="500" placeholder="Déposé, remplacé, cédé, détruit…" />
                            </label>
                            <p class="note">Le composant sort de l'inventaire actif ; son historique reste consultable. Ce retrait est définitif.</p>
                            <div class="actions debut">
                                <button type="submit" class="bouton-danger">Retirer de l'inventaire</button>
                                <a class="bouton-lien lien-discret" href="@Url(("action", null))">Annuler</a>
                            </div>
                        </EditForm>
                    }
                }
                <h3>Historique</h3>
                <ol class="historique">
                    @foreach (var e in fiche.Historique)
                    {
                        <li><strong>@Date(e.Le) · @(e.AuteurCompteId is null ? "Opération automatique" : e.Auteur ?? "Compte inconnu")</strong><br /><span>@Evenement(e)</span></li>
                    }
                </ol>
            </aside>
        }
    </div>
}
</main>

@code {
    [Parameter] public Guid OrganisationId { get; set; }

    [SupplyParameterFromQuery(Name = "site")] private Guid? SiteDemande { get; set; }

    [SupplyParameterFromQuery(Name = "zone")] private Guid? ZoneDemandee { get; set; }

    [SupplyParameterFromQuery(Name = "batiment")] private Guid? BatimentDemande { get; set; }

    [SupplyParameterFromQuery(Name = "corpsEtat")] private string? CorpsEtatDemande { get; set; }

    [SupplyParameterFromQuery(Name = "verification")] private bool? VerificationDemandee { get; set; }

    [SupplyParameterFromQuery(Name = "recherche")] private string? RechercheDemandee { get; set; }

    [SupplyParameterFromQuery(Name = "retires")] private bool? RetiresDemandes { get; set; }

    [SupplyParameterFromQuery(Name = "composant")] private Guid? ComposantDemande { get; set; }

    [SupplyParameterFromQuery(Name = "action")] private string? Action { get; set; }

    [SupplyParameterFromQuery(Name = "pour")] private Guid? BatimentCible { get; set; }

    [SupplyParameterFromForm(Name = "StructureSaisie", FormName = "structure")] private SaisieStructure? FormulaireStructure { get; set; }

    [SupplyParameterFromForm(Name = "ComposantSaisi", FormName = "composant")] private SaisieComposant? FormulaireComposant { get; set; }

    [SupplyParameterFromForm(Name = "RetraitSaisi", FormName = "retrait")] private SaisieRetrait? FormulaireRetrait { get; set; }

    private SaisieStructure StructureSaisie => FormulaireStructure ??= new() { BatimentId = BatimentCible };

    private SaisieComposant ComposantSaisi => FormulaireComposant ??= Action == "modifier" && Fiche is { Composant.RetireLe: null } fiche
        ? SaisieComposant.Depuis(fiche.Composant)
        : new() { ZoneId = ZoneDemandee };

    private SaisieRetrait RetraitSaisi => FormulaireRetrait ??= new();

    private OrganisationApi? Organisation { get; set; }

    private string[] RolesAppelant { get; set; } = [];

    private IReadOnlyList<SiteApi> Sites { get; set; } = [];

    private SiteApi? SiteCourant { get; set; }

    private bool PeutModifier { get; set; }

    private IReadOnlyList<BatimentApi> Structure { get; set; } = [];

    // Libellé de chaque zone : « Église · Sacristie ».
    private Dictionary<Guid, string> Zones { get; set; } = [];

    private IReadOnlyList<ComposantApi> Composants { get; set; } = [];

    private bool Tronquee { get; set; }

    private Dictionary<Guid, int> ComptesParZone { get; set; } = [];

    private FicheComposantApi? Fiche { get; set; }

    private string? Message { get; set; }

    // Bâtiment des formulaires « + Zone » et « + Niveau » : celui de l'arborescence, ses niveaux seulement.
    private BatimentApi? BatimentDuFormulaire => Structure.FirstOrDefault(b => b.Id == (StructureSaisie.BatimentId ?? BatimentCible));

    private bool Filtre => BatimentDemande is not null || !string.IsNullOrEmpty(CorpsEtatDemande) || VerificationDemandee == true
        || !string.IsNullOrWhiteSpace(RechercheDemandee) || RetiresDemandes == true;

    private string Resume
    {
        get
        {
            var zones = Structure.Sum(b => b.Zones.Count);
            var actifs = ComptesParZone.Values.Sum();
            return Structure.Count == 0
                ? "Décrivez le site : bâtiments, niveaux et zones, puis les composants de chaque zone."
                : $"{actifs} composant{(actifs > 1 ? "s" : "")} actif{(actifs > 1 ? "s" : "")} dans {zones} zone{(zones > 1 ? "s" : "")}";
        }
    }

    private string Base => $"/organizations/{OrganisationId}/sites/{SiteCourant!.Id}/inventory";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var moi = await Session.LireAsync<MoiApi>("/me", CancellationToken.None);
            Organisation = moi.Organisations.FirstOrDefault(o => o.Id == OrganisationId);
            RolesAppelant = Organisation?.Roles.Select(r => r.Role).Distinct().ToArray() ?? [];
            Sites = Perimetre.SitesInternes(Organisation);
            SiteCourant = Sites.FirstOrDefault(s => s.Id == SiteDemande) ?? Sites.FirstOrDefault();
            if (SiteCourant is { } site)
            {
                // Technicien, responsable et délégué modifient l'inventaire ; l'API reste juge (403 sinon).
                PeutModifier = Organisation!.Roles.Any(r => r.SiteId == site.Id && r.Role is "Technicien" or "Responsable" or "Delegue");
                // Aussi lors d'un envoi : Blazor n'accepte un formulaire que s'il figure dans la page rendue.
                await ChargerAsync();
            }
        }
        catch (SessionExpireeException)
        {
            Navigation.NavigateTo("/connexion");
        }
        catch (RefusApiException refus) when (refus.Statut is HttpStatusCode.NotFound or HttpStatusCode.Forbidden)
        {
            Message = "Vous ne consultez pas l'inventaire de ce site.";
        }
        catch (RefusApiException refus) when (refus.Statut == HttpStatusCode.UnprocessableEntity)
        {
            Message = $"Filtre refusé : {Libelles.Champ(refus.Champ)}.";
        }
        catch (RefusApiException)
        {
            Message = "Service momentanément indisponible : réessayez dans un instant.";
        }
    }

    private async Task ChargerAsync()
    {
        Structure = await Session.LireAsync<List<BatimentApi>>($"{Base}/structure", CancellationToken.None);
        Zones = Structure.SelectMany(b => b.Zones.Select(z => (z.Id, Libelle: $"{b.Nom} · {NomZone(b, z)}"))).ToDictionary(z => z.Id, z => z.Libelle);
        var requete = new List<string>();
        Ajouter(requete, "zoneId", ZoneDemandee?.ToString());
        Ajouter(requete, "batimentId", BatimentDemande?.ToString());
        Ajouter(requete, "corpsEtat", CorpsEtatDemande);
        Ajouter(requete, "verification", VerificationDemandee == true ? "true" : null);
        Ajouter(requete, "recherche", RechercheDemandee);
        Ajouter(requete, "retires", RetiresDemandes == true ? "true" : null);
        var liste = await Session.LireAsync<ListeComposantsApi>($"{Base}/components{(requete.Count == 0 ? "" : "?" + string.Join('&', requete))}", CancellationToken.None);
        Composants = liste.Composants;
        Tronquee = liste.Tronquee;
        // Comptes de l'arborescence : composants actifs de chaque zone, quels que soient les filtres et la limite de liste.
        ComptesParZone = (await Session.LireAsync<List<CompteZoneApi>>($"{Base}/components/counts", CancellationToken.None))
            .ToDictionary(c => c.ZoneId, c => c.Actifs);
        if (ComposantDemande is { } id)
        {
            try
            {
                Fiche = await Session.LireAsync<FicheComposantApi>($"{Base}/components/{id}", CancellationToken.None);
            }
            catch (RefusApiException refus) when (refus.Statut == HttpStatusCode.NotFound)
            {
                Message = "Ce composant n'existe pas sur ce site.";
            }
        }
    }

    private async Task EnregistrerStructureAsync()
    {
        var saisie = StructureSaisie;
        await EcrireAsync(async () =>
        {
            switch (saisie.Type)
            {
                case "batiment":
                    await Session.EcrireAsync<CreeApi>($"{Base}/buildings", new { nom = saisie.Nom }, CancellationToken.None);
                    break;
                case "niveau":
                    await Session.EcrireAsync<CreeApi>($"{Base}/buildings/{saisie.BatimentId}/levels", new { nom = saisie.Nom, ordre = saisie.Ordre }, CancellationToken.None);
                    break;
                default:
                    var zone = await Session.EcrireAsync<CreeApi>(
                        $"{Base}/zones", new { nom = saisie.Nom, batimentId = saisie.BatimentId, niveauId = saisie.NiveauId }, CancellationToken.None);
                    return Url(("action", null), ("pour", null), ("zone", zone.Id.ToString()), ("batiment", null));
            }

            return Url(("action", null), ("pour", null));
        });
    }

    private async Task EnregistrerComposantAsync()
    {
        var saisie = ComposantSaisi;
        await EcrireAsync(async () =>
        {
            var corps = saisie.Corps();
            Guid id;
            if (saisie.Id is { } existant)
            {
                await Session.ModifierAsync($"{Base}/components/{existant}", corps, CancellationToken.None);
                id = existant;
            }
            else
            {
                id = (await Session.EcrireAsync<CreeApi>($"{Base}/components", corps, CancellationToken.None)).Id;
            }

            return Url(("action", null), ("composant", id.ToString()));
        });
    }

    private async Task RetirerAsync()
    {
        var saisie = RetraitSaisi;
        await EcrireAsync(async () =>
        {
            await Session.ExecuterAsync($"{Base}/components/{ComposantDemande}/withdraw", new { motif = saisie.Motif, version = saisie.Version }, CancellationToken.None);
            return Url(("action", null));
        });
    }

    // Succès : retour à la page (rechargement GET, sans renvoi du formulaire). Refus : saisie conservée, message.
    private async Task EcrireAsync(Func<Task<string>> ecriture)
    {
        if (SiteCourant is null || !PeutModifier)
        {
            Message = "Vous ne modifiez pas l'inventaire de ce site.";
            return;
        }

        string destination;
        try
        {
            destination = await ecriture();
        }
        catch (SessionExpireeException)
        {
            Navigation.NavigateTo("/connexion");
            return;
        }
        catch (RefusApiException refus)
        {
            Message = refus.Code switch
            {
                "donnee_invalide" => $"{Libelles.Champ(refus.Champ)} : valeur refusée. {Aide(refus.Champ)}",
                "nom_existant" => "Ce nom existe déjà à cet endroit (majuscules ignorées).",
                "modifie_entre_temps" => "Quelqu'un d'autre vient de modifier ce composant : rechargez la fiche puis recommencez.",
                "composant_retire" => "Ce composant est retiré : il ne se modifie plus.",
                "interdit" => "Vous ne modifiez pas l'inventaire de ce site.",
                _ => refus.Statut == HttpStatusCode.NotFound ? "Élément introuvable sur ce site." : "Service momentanément indisponible : réessayez dans un instant.",
            };
            return;
        }

        Navigation.NavigateTo(destination);
    }

    private static string Aide(string? champ) => champ switch
    {
        "lot.repartition" => "La somme des quantités par état doit égaler la quantité totale.",
        "anneeMiseEnService" or "moisMiseEnService" => "Une date passée : l'année, et le mois si connu.",
        "ordre" => "Entre −10 et 100.",
        "zoneId" => "Choisissez une zone du site.",
        "soumisAVerification" => "Indiquez oui ou non.",
        "corpsEtat" => "Choisissez un corps d'état.",
        "lot.quantite" => "Pour un lot, une quantité entière entre 1 et 100 000.",
        "lot.unite" => "Choisissez une unité.",
        "niveauId" => "Choisissez un niveau de ce bâtiment.",
        "batimentId" => "Choisissez un bâtiment du site.",
        "version" => "Rechargez la fiche puis recommencez.",
        "nom" or "emplacement" or "marque" or "modele" or "numeroSerie" or "remarques" or "motif" =>
            "Un texte visible, dans la longueur indiquée.",
        _ => "Vérifiez cette valeur.",
    };

    private string Url(params (string Cle, string? Valeur)[] changements)
    {
        var parametres = new List<(string Cle, string? Valeur)>
        {
            ("site", SiteCourant?.Id.ToString()), ("zone", ZoneDemandee?.ToString()), ("batiment", BatimentDemande?.ToString()),
            ("corpsEtat", CorpsEtatDemande), ("verification", VerificationDemandee == true ? "true" : null), ("recherche", RechercheDemandee),
            ("retires", RetiresDemandes == true ? "true" : null), ("composant", ComposantDemande?.ToString()), ("action", null), ("pour", null),
        };
        foreach (var (cle, valeur) in changements)
        {
            var index = parametres.FindIndex(p => p.Cle == cle);
            parametres[index] = (cle, valeur);
        }

        var requete = new List<string>();
        foreach (var (cle, valeur) in parametres)
        {
            Ajouter(requete, cle, valeur);
        }

        return $"/organisations/{OrganisationId}/inventaire?{string.Join('&', requete)}";
    }

    private static void Ajouter(List<string> requete, string cle, string? valeur)
    {
        if (!string.IsNullOrWhiteSpace(valeur))
        {
            requete.Add($"{cle}={Uri.EscapeDataString(valeur)}");
        }
    }

    private RenderFragment LienZone(ZoneApi zone, int retrait) =>
        @<a class="@($"arbre-zone retrait-{retrait}{(zone.PartiesCommunes ? " communes" : "")}")" href="@Url(("zone", zone.Id.ToString()), ("batiment", null))"
            aria-current="@(ZoneDemandee == zone.Id ? "page" : null)">@zone.Nom <span>@ComptesParZone.GetValueOrDefault(zone.Id)</span></a>;

    // Ordre unique de l'arborescence : zones sans niveau, chaque niveau (en-tête puis ses zones), parties communes.
    private static IEnumerable<(NiveauApi? Niveau, ZoneApi? Zone)> Arborescence(BatimentApi batiment)
    {
        foreach (var zone in batiment.Zones.Where(z => z.NiveauId is null && !z.PartiesCommunes))
        {
            yield return (null, zone);
        }

        foreach (var niveau in batiment.Niveaux)
        {
            yield return (niveau, null);
            foreach (var zone in batiment.Zones.Where(z => z.NiveauId == niveau.Id))
            {
                yield return (niveau, zone);
            }
        }

        foreach (var zone in batiment.Zones.Where(z => z.PartiesCommunes))
        {
            yield return (null, zone);
        }
    }

    private static IEnumerable<ZoneApi> ZonesRangees(BatimentApi batiment) => Arborescence(batiment).Where(e => e.Zone is not null).Select(e => e.Zone!);

    private static string NomZone(BatimentApi batiment, ZoneApi zone) =>
        batiment.Niveaux.FirstOrDefault(n => n.Id == zone.NiveauId) is { } niveau ? $"{zone.Nom} ({niveau.Nom})" : zone.Nom;

    private static RenderFragment QuantiteEtEtat(ComposantApi c) => c.Lot switch
    {
        null => @<span class="vide">Non évalué</span>,
        { Repartition: null } lot => @<span class="vide">@lot.Quantite @Libelles.Unite(lot.Unite, lot.Quantite) · non évalué</span>,
        { Repartition: { } r } lot => @<span class="quantite-etat">
            @* SVG : la politique de sécurité interdit les styles en ligne ; les proportions passent par la géométrie. *@
            <svg class="barre-etats" viewBox="0 0 @lot.Quantite 1" preserveAspectRatio="none" role="img"
                aria-label="@string.Join(", ", Libelles.Etats.Where(e => Nombre(r, e.Cle) > 0).Select(e => $"{Nombre(r, e.Cle)} {e.Libelle.ToLowerInvariant()}"))">
                @foreach (var (x, nombre, classe) in Segments(r))
                {
                    <rect class="@classe" x="@x" y="0" width="@nombre" height="1" />
                }
            </svg>
            <span class="vide">@lot.Quantite @Libelles.Unite(lot.Unite, lot.Quantite)</span>
        </span>,
    };

    private static IEnumerable<(int X, int Nombre, string Classe)> Segments(RepartitionApi r)
    {
        var x = 0;
        foreach (var (cle, _, classe) in Libelles.Etats)
        {
            var nombre = Nombre(r, cle);
            if (nombre > 0)
            {
                yield return (x, nombre, classe);
                x += nombre;
            }
        }
    }

    private static int Nombre(RepartitionApi r, string cle) => cle switch
    {
        "bon" => r.Bon,
        "satisfaisant" => r.Satisfaisant,
        "degrade" => r.Degrade,
        "mauvais" => r.Mauvais,
        _ => r.Critique,
    };

    // « Modification : bon 40 → 32, dégradé 0 → 8 » (ou « Évaluation : … ») ; création et retrait résumés.
    private static string Evenement(EvenementApi e)
    {
        switch (e.Nature)
        {
            case "Creation":
                return e.Apres is { } apres && apres.TryGetProperty("quantite", out var quantite) && quantite.ValueKind == JsonValueKind.Number
                    ? $"Création : lot de {quantite.GetInt32()} {Libelles.Unite(Texte(apres, "unite"), quantite.GetInt32())}"
                    : "Création";
            case "Retrait":
                return $"Retrait : {(e.Apres is { } motif ? Texte(motif, "motif") : "")}";
            default:
                // Évaluation (US-11) : répartition du lot reprise de l'évaluation, présentée comme une modification.
                var nature = e.Nature == "Evaluation" ? "Évaluation" : "Modification";
                if (e.Avant is not { ValueKind: JsonValueKind.Object } avant || e.Apres is not { ValueKind: JsonValueKind.Object } apresModif)
                {
                    return nature;
                }

                var changes = apresModif.EnumerateObject().Where(p => p.Name != "zoneId").OrderBy(p => Libelles.Rang(p.Name))
                    .Select(p => $"{Libelles.Champ(p.Name).ToLowerInvariant()} {Valeur(p.Name, avant.TryGetProperty(p.Name, out var v) ? v : default)} → {Valeur(p.Name, p.Value)}");
                return $"{nature} : {string.Join(", ", changes)}";
        }
    }

    private static string Texte(JsonElement objet, string propriete) =>
        objet.TryGetProperty(propriete, out var valeur) && valeur.ValueKind == JsonValueKind.String ? valeur.GetString() ?? "" : "";

    private static string Valeur(string champ, JsonElement valeur) => valeur.ValueKind switch
    {
        JsonValueKind.String when champ == "corpsEtat" => Libelles.CorpsEtat(valeur.GetString()!),
        JsonValueKind.String when champ == "unite" => Libelles.Unite(valeur.GetString()!, 1),
        JsonValueKind.String => $"« {valeur.GetString()} »",
        JsonValueKind.Number when champ == "moisMiseEnService" && valeur.GetInt32() is >= 1 and <= 12 => Libelles.Mois[valeur.GetInt32() - 1],
        JsonValueKind.Number => valeur.GetRawText(),
        JsonValueKind.True => "oui",
        JsonValueKind.False => "non",
        _ => "—",
    };

    private static string Date(DateTimeOffset date) => Perimetre.Date(date);

