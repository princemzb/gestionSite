@* Navigation latérale de l'administration (maquette C, UX-02) : entrées selon les rôles dans l'organisation. *@
<nav class="admin-nav" aria-label="Navigation principale">
    <span class="marque">gestionSite</span>
    @if (OrganisationId != Guid.Empty)
    {
        <span class="organisation">@Organisation</span>
        @if (Interne)
        {
            <a href="@($"/organisations/{OrganisationId}/depots")" aria-current="@(Courant == "depots" ? "page" : null)">Dépôts reçus</a>
        }
        @if (Encadrement)
        {
            <a href="@($"/organisations/{OrganisationId}/sites")" aria-current="@(Courant == "sites" ? "page" : null)">Sites</a>
        }
        @if (Administrateur)
        {
            <a href="@($"/organisations/{OrganisationId}/membres")" aria-current="@(Courant == "membres" ? "page" : null)">Membres</a>
        }
    }
    <form method="post" action="/deconnexion">
        <AntiforgeryToken />
        <button type="submit">Se déconnecter</button>
    </form>
</nav>

@code {
    [Parameter] public Guid OrganisationId { get; set; }

    [Parameter] public string? Organisation { get; set; }

    /// <summary>Rôles de l'appelant dans l'organisation (« Administrateur », « Responsable »…).</summary>
    [Parameter] public IReadOnlyCollection<string> Roles { get; set; } = [];

    /// <summary>Entrée courante : « depots », « sites » ou « membres ».</summary>
    [Parameter] public string Courant { get; set; } = string.Empty;

    private bool Administrateur => Roles.Contains("Administrateur");

    // Dépôts reçus : comptes internes d'un site (DEC-04), pas l'administrateur seul.
    private bool Interne => Roles.Any(r => r is "Technicien" or "Responsable" or "Delegue" or "Pasteur" or "Coordination");

    // Lien public et QR : administrateur, responsable et délégués (décision du 28/10).
    private bool Encadrement => Administrateur || Roles.Contains("Responsable") || Roles.Contains("Delegue");
}
