@* Navigation latérale de l'administration (maquette C, UX-02) : entrées selon les rôles dans l'organisation.
   US-31 (maquette 4A) : sélecteur d'organisation (deux organisations ou plus) et carte des invitations en attente. *@
@inject SessionApi Session
<nav class="admin-nav" aria-label="Navigation principale">
    <span class="marque">gestionSite</span>
    @if (OrganisationId != Guid.Empty)
    {
        @if (Autres.Count > 0)
        {
            <details class="organisation-choix">
                <summary><small>Organisation</small><span>@Organisation</span></summary>
                <ul aria-label="Changer d'organisation">
                    @foreach (var autre in Autres)
                    {
                        <li><a href="@($"/?organisation={autre.Id}")">@autre.Nom</a></li>
                    }
                </ul>
            </details>
        }
        else
        {
            <span class="organisation">@Organisation</span>
        }
        @if (Interne)
        {
            <a href="@($"/organisations/{OrganisationId}/etat")" aria-current="@(Courant == "etat" ? "page" : null)">État du site</a>
            <a href="@($"/organisations/{OrganisationId}/dossiers")" aria-current="@(Courant == "dossiers" ? "page" : null)">Dossiers</a>
            @if (Terrain)
            {
                <a href="@($"/organisations/{OrganisationId}/interventions")" aria-current="@(Courant == "interventions" ? "page" : null)">Mes interventions</a>
            }
            <a href="@($"/organisations/{OrganisationId}/inventaire")" aria-current="@(Courant == "inventaire" ? "page" : null)">Inventaire</a>
            <a href="@($"/organisations/{OrganisationId}/plans")" aria-current="@(Courant == "plans" ? "page" : null)">Plans</a>
            <a href="@($"/organisations/{OrganisationId}/preventif")" aria-current="@(Courant == "preventif" ? "page" : null)">Préventif</a>
            @if (Roles.Any(r => r is "Responsable" or "Delegue"))
            {
                <a href="@($"/organisations/{OrganisationId}/grilles")" aria-current="@(Courant == "grilles" ? "page" : null)">Grilles d'évaluation</a>
            }
        }
        @if (Encadrement)
        {
            <a href="@($"/organisations/{OrganisationId}/sites")" aria-current="@(Courant == "sites" ? "page" : null)">Sites</a>
        }
        @if (Administrateur)
        {
            <a href="@($"/organisations/{OrganisationId}/membres")" aria-current="@(Courant == "membres" ? "page" : null)">Membres</a>
        }
    }
    <form method="post" action="/deconnexion">
        <AntiforgeryToken />
        <button type="submit">Se déconnecter</button>
    </form>
</nav>
@if (Invitations.Count > 0)
{
    <div class="admin-invitations">
        @foreach (var invitation in Invitations)
        {
            <CarteInvitation Invitation="invitation" OrganisationActuelle="@Organisation" />
        }
    </div>
}

@code {
    [Parameter] public Guid OrganisationId { get; set; }

    [Parameter] public string? Organisation { get; set; }

    /// <summary>Rôles de l'appelant dans l'organisation (« Administrateur », « Responsable »…).</summary>
    [Parameter] public IReadOnlyCollection<string> Roles { get; set; } = [];

    /// <summary>Entrée courante : « etat », « dossiers », « interventions », « inventaire », « grilles », « sites » ou « membres ».</summary>
    [Parameter] public string Courant { get; set; } = string.Empty;

    private bool Administrateur => Roles.Contains("Administrateur");

    // État du site, dossiers et inventaire : comptes internes d'un site (DEC-04), pas l'administrateur seul.
    private bool Interne => Roles.Any(r => r is "Technicien" or "Responsable" or "Delegue" or "Pasteur" or "Coordination");

    // Mes interventions : rôles de terrain (technicien, responsable, délégué).
    private bool Terrain => Roles.Any(r => r is "Technicien" or "Responsable" or "Delegue");

    // Lien public et QR : administrateur, responsable et délégués (décision du 28/10).
    private bool Encadrement => Administrateur || Roles.Contains("Responsable") || Roles.Contains("Delegue");

    private IReadOnlyList<OrganisationApi> Autres { get; set; } = [];

    private IReadOnlyList<InvitationApi> Invitations { get; set; } = [];

    // Profil déjà lu par la page pendant la requête (SessionApi.MoiAsync) : aucun appel en plus. Une erreur ici ne bloque
    // pas la navigation : la page signale déjà la session expirée ou l'indisponibilité.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var moi = await Session.MoiAsync(CancellationToken.None);
            Autres = [.. moi.Organisations.Where(o => o.Id != OrganisationId)];
            Invitations = moi.Invitations ?? [];
        }
        catch (Exception erreur) when (erreur is SessionExpireeException or RefusApiException)
        {
            Autres = [];
            Invitations = [];
        }
    }
}
