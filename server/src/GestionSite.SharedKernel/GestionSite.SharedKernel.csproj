<Project Sdk="Microsoft.NET.Sdk">
  <!-- Socle commun aux modules (SOC-01) : isolation par organisation (intercepteurs RLS, contexte de base, migrations),
       configuration PostgreSQL, refus HTTP communs, traitement des photos. Paquets et cadre ASP.NET Core seulement, aucun projet. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Photos (dépôt, clôture, évaluation) : lecture JPEG/PNG/HEIC, orientation, métadonnées retirées, réencodage JPEG. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
</Project>
